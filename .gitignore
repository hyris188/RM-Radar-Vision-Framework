# Never commit trained weights or weight backups.
*.pt
*.pth
*.onnx
*.engine
*.ckpt
*.safetensors
*.trt
weights/
checkpoints/
**/weights/
**/checkpoints/

# Private datasets, annotations and captured media.
/datasets/
/dataset*/
/data/
/data*/
/labels/
/images/
/videos/
/recordings/
/rejected/
/backups/
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.gif
*.mp4
*.avi
*.mkv
*.cache

# Training output and local machine configuration.
runs/
training_workspace/
logs/
configs/deployment/*.local.yaml
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.vscode/
.idea/

# Archives may contain private data or weights.
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
